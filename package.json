{
    "name": "better-comments",
    "displayName": "Better Comments",
    "icon": "icon.png",
    "description": "Improve your code commenting by annotating with alert, informational, TODOs, and more!",
    "version": "3.1.1",
    "publisher": "aaron-bond",
    "author": {
        "name": "Aaron Bond"
    },
    "homepage": "https://github.com/aaron-bond/better-comments/blob/main/README.md",
    "license": "SEE LICENSE IN LICENSE.md",
    "repository": {
        "type": "git",
        "url": "https://github.com/aaron-bond/better-comments"
    },
    "bugs": "https://github.com/aaron-bond/better-comments/issues",
    "categories": [
        "Formatters"
    ],
    "engines": {
        "vscode": "^1.101.0"
    },
    "extensionKind": [
        "ui",
        "workspace"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "galleryBanner": {
        "color": "#e3f4ff",
        "theme": "light"
    },
    "browser": "./out/web/extension.js",
    "main": "./out/extension",
    "scripts": {
        "vscode:prepublish": "npm run compile && npm run package-web",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "lint": "eslint .",
        "compile-web": "webpack --config ./build/web-extension.webpack.config.js",
        "watch-web": "webpack --watch --config ./build/web-extension.webpack.config.js",
        "package-web": "webpack --mode production --devtool hidden-source-map --config ./build/web-extension.webpack.config.js",
        "compile-tests": "tsc -p ./test",
        "test:baseline:host": "npm run compile && npm run compile-tests && node out/test/host/runTests.js baseline",
        "test:integration": "npm run compile && npm run compile-tests && node out/test/host/runTests.js integration",
        "test:unit": "mocha --config test/.mocharc.json \"test/unit/**/*.test.ts\"",
        "test:node": "mocha --config test/.mocharc.json \"test/node/**/*.test.ts\"",
        "test": "npm run test:unit && npm run test:node",
        "test:host": "npm run compile && npm run compile-tests && node out/test/host/runTests.js baseline && node out/test/host/runTests.js integration && node out/test/host/runTests.js activation",
        "test:all": "npm test && npm run test:host",
        "perf": "npm run compile && npm run compile-tests && node out/test/perf/run.js",
        "perf:report": "node out/test/perf/report.js",
        "coverage": "c8 --all --include \"src/**\" --include \"out/**\" --exclude \"out/test/**\" --exclude \"out/web/**\" --exclude \"src/core/types.ts\" --exclude \"out/core/types.js\" --exclude \"src/**/*.d.ts\" --reporter text --reporter html --reports-dir coverage npm run test:all"
    },
    "contributes": {
        "configuration": {
            "title": "Better Comments configuration",
            "properties": {
                "better-comments.multilineComments": {
                    "type": "boolean",
                    "description": "Whether the multiline comment highlighter should be active",
                    "default": true
                },
                "better-comments.highlightPlainText": {
                    "type": "boolean",
                    "description": "Whether the plaintext comment highlighter should be active",
                    "default": false
                },
                "better-comments.tags": {
                    "type": "array",
                    "description": "Tags which are used to color the comments. Changes require a restart of VS Code to take effect",
                    "items": {
                        "type": "object",
                        "required": [
                            "tag"
                        ],
                        "defaultSnippets": [
                            {
                                "label": "New tag",
                                "body": {
                                    "tag": "$1",
                                    "color": "${2:#FF2D00}"
                                }
                            }
                        ],
                        "properties": {
                            "tag": {
                                "type": "string",
                                "minLength": 1,
                                "description": "The characters or word that mark a comment, such as \"!\" or \"todo\". It must come first in a line comment, or first on its line in a block comment, and case doesn't matter"
                            },
                            "color": {
                                "description": "The text colour: a hex colour, any CSS colour, or a theme colour such as { \"id\": \"editorError.foreground\" }",
                                "anyOf": [
                                    {
                                        "type": "string",
                                        "format": "color"
                                    },
                                    {
                                        "type": "string",
                                        "description": "Any CSS colour, such as \"transparent\" or \"rgba(255, 0, 0, 0.5)\""
                                    },
                                    {
                                        "type": "object",
                                        "description": "A colour from the current theme",
                                        "required": [
                                            "id"
                                        ],
                                        "properties": {
                                            "id": {
                                                "type": "string",
                                                "description": "A theme colour id, such as \"editorError.foreground\""
                                            }
                                        }
                                    }
                                ]
                            },
                            "backgroundColor": {
                                "description": "The background colour, in the same forms as color",
                                "anyOf": [
                                    {
                                        "type": "string",
                                        "format": "color"
                                    },
                                    {
                                        "type": "string",
                                        "description": "Any CSS colour, such as \"transparent\" or \"rgba(255, 0, 0, 0.5)\""
                                    },
                                    {
                                        "type": "object",
                                        "description": "A colour from the current theme",
                                        "required": [
                                            "id"
                                        ],
                                        "properties": {
                                            "id": {
                                                "type": "string",
                                                "description": "A theme colour id, such as \"editorError.foreground\""
                                            }
                                        }
                                    }
                                ]
                            },
                            "strikethrough": {
                                "type": "boolean",
                                "description": "Strike through the comment"
                            },
                            "underline": {
                                "type": "boolean",
                                "description": "Underline the comment"
                            },
                            "bold": {
                                "type": "boolean",
                                "description": "Make the comment bold"
                            },
                            "italic": {
                                "type": "boolean",
                                "description": "Make the comment italic"
                            }
                        }
                    },
                    "default": [
                        {
                            "tag": "!",
                            "color": "#FF2D00",
                            "strikethrough": false,
                            "underline": false,
                            "backgroundColor": "transparent",
                            "bold": false,
                            "italic": false
                        },
                        {
                            "tag": "?",
                            "color": "#3498DB",
                            "strikethrough": false,
                            "underline": false,
                            "backgroundColor": "transparent",
                            "bold": false,
                            "italic": false
                        },
                        {
                            "tag": "//",
                            "color": "#474747",
                            "strikethrough": true,
                            "underline": false,
                            "backgroundColor": "transparent",
                            "bold": false,
                            "italic": false
                        },
                        {
                            "tag": "todo",
                            "color": "#FF8C00",
                            "strikethrough": false,
                            "underline": false,
                            "backgroundColor": "transparent",
                            "bold": false,
                            "italic": false
                        },
                        {
                            "tag": "*",
                            "color": "#98C379",
                            "strikethrough": false,
                            "underline": false,
                            "backgroundColor": "transparent",
                            "bold": false,
                            "italic": false
                        }
                    ]
                }
            }
        }
    },
    "dependencies": {
        "json5": "^2.2.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/mocha": "^10.0.10",
        "@types/node": "~22.15.0",
        "@types/vscode": "~1.101.0",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^4.0.0",
        "c8": "^12.0.0",
        "eslint": "^10.13.0",
        "mocha": "^12.0.3",
        "path-browserify": "^1.0.1",
        "process": "^0.11.10",
        "ts-loader": "^9.6.2",
        "ts-node": "^10.9.2",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "util": "^0.12.5",
        "webpack": "^5.112.2",
        "webpack-cli": "^7.2.3"
    }
}
