{
	"compilerOptions": {
		"strict": true,
		"module": "commonjs",
		// VS Code 1.101, the oldest supported version, runs extensions on Node 22
		"target": "es2022",
		"lib": [
			"es2022"
		],
		"types": [
			"node"
		],
		"outDir": "out",
		"rootDir": "src",
		"sourceMap": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true
	},
	"include": [
		"src"
	]
}
